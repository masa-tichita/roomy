# Generated by .github/workflows/release.yml from packaging/homebrew/roomy.rb.in in
# masa-tichita/roomy. Edit the template there, not this file.
class Roomy < Formula
  desc "Keeps your Mac roomy: finds what is safe to delete, warns before space runs out"
  homepage "https://github.com/masa-tichita/roomy"
  url "https://github.com/masa-tichita/roomy/releases/download/v@VERSION@/roomy-v@VERSION@-universal-apple-darwin.tar.gz"
  sha256 "@SHA256@"
  license any_of: ["MIT", "Apache-2.0"]

  depends_on :macos

  def install
    bin.install "roomy"
@COMPLETIONS@
  end

  # Checks free space and memory every 15 minutes and scans once a day.
  service do
    run [opt_bin/"roomy", "tick"]
    run_type :interval
    interval 900
    process_type :background
    environment_variables PATH: std_service_path_env
    log_path var/"log/roomy.log"
    error_log_path var/"log/roomy.log"
  end

  def caveats
    <<~EOS
      Start the background checks (free space, memory, daily scan):
        brew services start roomy

      Use it from AI agents:
        claude mcp add --scope user roomy -- roomy mcp
        roomy guide

      Optional: give Full Disk Access to #{opt_bin}/roomy so background scans
      also cover Documents, Downloads and other apps' data. Unsigned builds need
      this again after each upgrade.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/roomy --version")
    ENV["HOME"] = testpath
    assert_match "\"schema\":1", shell_output("#{bin}/roomy rules --json")
    system bin/"roomy", "config", "validate"
  end
end
